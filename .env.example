# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://fleet-managment-system-2-0.onrender.com,https://truck-tracker-api-9yhq.onrender.com

# Authentication (Minimum 32 random characters in production)
JWT_SECRET=your-secure-random-jwt-secret-here-min-32-chars

# Database driver: sqlite (zero external dependency for local dev), postgres (Render/Neon), or sqlserver (MSSQL)
DB_DRIVER=sqlite
# SQLite database path (defaults to ./data/truck_tracker.sqlite)
SQLITE_DB_PATH=./data/truck_tracker.sqlite

# PostgreSQL connection (required when DB_DRIVER=postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/truck_tracker
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Company SQL Server alternative (use only after the SQL Server migration is validated)
# DB_DRIVER=sqlserver
# DB_SERVER=company-sql-server.example.internal
# DB_PORT=1433
# DB_NAME=truck_tracker
# DB_USER=truck_tracker_app
# DB_PASSWORD=replace-in-secret-manager
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false

# Initial Production Administrator / Manager Account
# (Provisioned cleanly if database is empty - 0 dummy trips/fleet created)
INITIAL_ADMIN_EMAIL=manager@company.com
INITIAL_ADMIN_PASSWORD=change-me-to-a-secure-production-password
AUTO_SEED=false

# Upload storage path (Use a persistent mounted directory in container environments)
# Production/container deployments should point to a durable volume, for example:
# UPLOADS_DIR=/data/uploads/photos
UPLOADS_DIR=./uploads/photos

# ==============================================================================
# HoseXperts Company API Integration (FMS & Sales Orders Gateway)
# ==============================================================================
HOSEXPERTS_API_URL=https://api.hosexperts.com:85/apiv2.php
HOSEXPERTS_API_REJECT_UNAUTHORIZED=false
HOSEXPERTS_SYNC_ENABLED=true

# ==============================================================================
# SAP ONE Portal ERP Integration (Enterprise Fleet Ledger)
# ==============================================================================
SAP_ONE_PORTAL_URL=https://oneportal.company.internal/api/v1
SAP_ONE_COMPANY_DB=HOSEXPERTS_LIVE
SAP_ONE_USERNAME=b1_dispatcher_service
SAP_ONE_PASSWORD=your-sap-service-layer-password
SAP_ONE_SYNC_ENABLED=true

# ==============================================================================
# Mapping & Geospatial Configuration (Mapbox GL JS)
# ==============================================================================
# Mapbox public access token (e.g. pk.eyJ1...)
VITE_MAPBOX_TOKEN=pk.your-public-mapbox-access-token-here
