# TruckTracker Web - Environment Configuration

# Base URL for API calls.
# If hosting frontend and backend on separate domains (e.g. Frontend on Vercel, Backend on Render/Railway/VPS):
# Set this to your deployed backend URL including /api, e.g.:
# VITE_API_BASE_URL=https://truck-tracker-api.onrender.com/api
#
# When left empty, defaults to '/api' which works with Vite proxy in local dev or reverse proxy setups.
VITE_API_BASE_URL=
